# Copy to .env.local and enter the web stream's Google Analytics measurement ID.
# This identifier is public and is embedded in the production build.
VITE_GA_MEASUREMENT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Activar solo después de ejecutar los SQL y verificar acceso y catálogo.
VITE_LIVE_PRICES=false
